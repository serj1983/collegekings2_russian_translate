# game/v3/scene22.rpy:1213
translate russian v3s22_5d6dae2a:

    # u "Anytime, really."
    u "В любое время."

# game/v3/scene22.rpy:1218
translate russian v3s22_b3df98a1:

    # am "I'll see you soon?"
    am "Скоро увидимся?"

# game/v3/scene22.rpy:1223
translate russian v3s22_48c66863:

    # u "You will."
    u "Само собой."

# game/v3/scene22.rpy:1228
translate russian v3s22_1341bcba:

    # u "Have a good night, guys. Good luck tomorrow!"
    u "Доброй ночи, ребят. Удачи завтра!"

# game/v3/scene22.rpy:1233
